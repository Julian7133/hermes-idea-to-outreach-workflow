# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Postgres ---
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hermes

# --- n8n access / encryption ---
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-32-byte-hex
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Berlin
# Public base URL Mailgun can POST webhooks to. In local dev, expose 5678 with a
# tunnel (cloudflared / ngrok) and put that HTTPS URL here, e.g.
#   WEBHOOK_URL=https://hermes.example-tunnel.dev/
WEBHOOK_URL=http://localhost:5678/

# --- Mailgun (EU region, per plan §5.2) ---
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=out.berlow.de
MAILGUN_BASE_URL=https://api.eu.mailgun.net/v3
# Mailgun → Webhooks signing key (Settings → Webhooks). Used by 4c to verify HMAC.
MAILGUN_WEBHOOK_SIGNING_KEY=change-me

# --- Outreach copywriter LLM (Workflow 4b) ---
# Anthropic Messages API. Default to the latest capable model.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OUTREACH_LLM_MODEL=claude-opus-4-8

# --- IMAP inbox for reply-stop (Workflow 4c) ---
IMAP_HOST=imap.your-provider.tld
IMAP_PORT=993
IMAP_USER=hello@out.berlow.de
IMAP_PASSWORD=change-me
